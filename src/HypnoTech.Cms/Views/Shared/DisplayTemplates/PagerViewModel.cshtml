@model HypnoTech.Common.Models.PagerViewModel
<div class="container">
    <div class="row justify-content-center text-center border-top py-3 mt-5">

        @if (Model.Visible)
        {
            <div class="col">

                @if (Model.CanGoPrevious)
                {
                <a class="btn btn-sm btn-light" href="/@Model.PreviousUrl" data-navigo>Previous</a>
                }
            </div>

            <div class="col"><p>Page <strong>@Model.CurrentPage</strong> out of <strong>@Model.TotalPages</strong></p></div>

            <div class="col">
                @if (Model.CanGoNext)
                {
                <a class="btn btn-sm btn-light" href="/@Model.NextUrl" data-navigo>Next</a>
                }
            </div>
        }

    </div>
</div>