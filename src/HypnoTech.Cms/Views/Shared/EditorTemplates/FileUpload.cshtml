@model HypnoTech.Cms.Forms.Controls.FileUploadFormControl
<div id="@Model.Anchor">
    <label for="@Model.Id">@Model.Label</label>
    <!-- ko if: hasFile -->
    <div class="card mb-3">
        <div class="card-header text-right">
            <button type="button" class="btn btn-secondary btn-sm" data-bind="click: removeFile"><i class="fa fa-times"></i><span class="sr-only">Remove Image</span></button>
        </div>
        <div class="card-body text-center">
            <p data-bind="text: fileText"></p>
            <!-- ko if: isAudio -->
            <audio src="" data-bind="attr: { src: file }" controls></audio>
            <!-- /ko -->
        </div>
    </div>
    <input type="hidden" name="@Model.Name" data-bind="value: filePath" />
    <!-- /ko -->
    <div class="input-group mb-3" data-bind="visible: !hasFile()">
        <div class="custom-file">
            <input type="file" id="@Model.Id" name="Files" data-bind="fileUpload: uploadedFile" />
            <label class="custom-file-label" for="@Model.Id">Choose file</label>
        </div>
    </div>
    <!-- ko if: hasAddedFile -->
    <input type="hidden" name="AddedFiles" value="@Model.Name" />
    <!-- /ko -->
    <!-- ko if: hasRemovedFile -->
    <input type="hidden" name="RemovedFiles" value="@Model.FilePath" />
    <!-- /ko -->
</div>