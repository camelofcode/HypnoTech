@model dynamic

<div class="modal fade" id="deleteModal@(Model.ListName)" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel@(Model.ListName)" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel@(Model.ListName)" data-bind="text: templateHeaderText"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- ko if: selectedItem -->
                <p>Are you sure you want to delete <strong data-bind="text: itemToDeleteName"></strong>?</p>
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-dark" data-dismiss="modal" data-bind="click: removeItem">Delete</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addEditModal@(Model.ListName)" tabindex="-1" role="dialog" aria-labelledby="addEditModalLabel@(Model.ListName)" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="addEditModalModalLabel@(Model.ListName)" data-bind="text: templateHeaderText"></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <!-- ko template: template -->
                <!-- /ko -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-dark" data-bind="click: saveItem">Save</button>
            </div>
        </div>
    </div>
</div>