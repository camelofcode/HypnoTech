@model object

@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Forgot Password";
}
<div class="container">
    <div class="row  justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-5">
                <a href="/Home/Login" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
                Forgot Password
            </h1>
            <div class="card">
                <div class="card-body">
                    An email has been sent to your email address with a link to reset your password.
                </div>
            </div>
        </div>
    </div>
</div>