@model HypnoTech.Cms.Areas.Settings.ViewModels.EditUserViewModel

@{
    ViewBag.Title = "Edit User";
    Layout = "_SettingsLayout";
}
<div class="container">
    <h1 class="mb-5">
        <a href="/Settings/User" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
        Edit User
    </h1>
    <div class="row justify-content-between">
        <form class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-5" method="POST">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)
            <h3>Edit Details</h3>
            <div class="form-group">
                <label for="username-input">Username</label>
                <div class="input-group m-w-250">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-user"></i></span>
                    </div>
                    <input class="form-control" type="text" value="@Model.Username" id="username-input" name="@Html.NameFor(model => model.Username)">
                </div>
                <div class="invalid-feedback m-w-250">
                    Username must be unique and not contain special characters
                </div>
            </div>
            <div class="form-group">
                <label for="email-input">Email Address</label>
                <div class="input-group m-w-250">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                    </div>
                    <input class="form-control" id="email-input" type="email" value="@Model.Email" name="@Html.NameFor(model => model.Email)">
                    <div class="invalid-feedback">
                        Invalid email
                    </div>
                </div>

            </div>
            <div class="form-group">
                <label>Roles</label>
                @foreach (var role in Model.AvailableRoles)
                {
                    <div class="d-flex justify-content-between mb-2 m-w-250">
                        <span class="badge badge-dark"><span class="lead">@role</span></span>
                        <label class="switch">
                            <input type="checkbox" value="@role" @(Model.Roles.Contains(role) ? "checked" : string.Empty) name="@Html.NameFor(model => model.Roles)">
                            <span class="slider"></span>
                        </label>
                    </div>
                }

            </div>

            <div class="d-flex mt-5 justify-content-between m-w-250"">
                <a class="btn btn-secondary" href="/Settings/User">Cancel</a>
                <button class="btn btn-dark" type="submit">Update User</button>
            </div>
        </form>

        <form class="col-xl-3 col-lg-4 col-md-6 col-sm-12 mb-5" method="POST" action="/Settings/User/ChangePassword">
            @Html.AntiForgeryToken()
            @Html.HiddenFor(model => model.Id)
            <h3>Change Password</h3>
            <div class="form-group">
                <label for="new-password-input">Enter New Password</label>
                <div class="input-group m-w-250"">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-key"></i></span>
                    </div>
                    <input class="form-control" id="new-password-input" type="password" name="Password">
                </div>
            </div>
            <div class="form-group">
                <label for="repeat-new-password-input">Repeat New Password</label>
                <div class="input-group m-w-250"">
                    <div class="input-group-prepend">
                        <span class="input-group-text"><i class="fa fa-key"></i></span>
                    </div>
                    <input class="form-control" id="repeat-new-password-input" type="password" name="ConfirmPassword">
                    <div class="invalid-feedback">
                        Passwords don't match
                    </div>
                </div>
            </div>

            <div class="d-flex mt-5 justify-content-between m-w-250"">
                <a class="btn btn-secondary" href="/Settings/User">Cancel</a>
                <button class="btn btn-dark" type="submit">Change Password</button>
            </div>
        </form>
    </div>
</div>
