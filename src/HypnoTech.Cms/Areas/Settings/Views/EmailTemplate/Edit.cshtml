@model HypnoTech.Common.Models.EmailTemplate
@using HypnoTech.Common.Extensions
@{
    ViewBag.Title = "Edit Email Template";
    Layout = "_SettingsLayout";
}
<div class="container">
    <h2>
        <a href="/Settings/EmailTemplate" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
        Edit @Model.EmailType.ToString() Template
    </h2>
    <form method="POST">
        @Html.AntiForgeryToken()
        @Html.HiddenFor(p => p.Id)
        @Html.HiddenFor(p => p.EmailType)
        <div class="form-group">
            <label for="description-input">Description</label>
            <input class="form-control" type="text" value="@Model.EmailType.GetDescription()" id="description-input" readonly>
        </div>
        <div class="form-group">
            <label for="subject-input">Subject</label>
            <input class="form-control" type="text" value="@Model.Subject" id="subject-input" name="@Html.NameFor(p => p.Subject)">
        </div>
        <div class="form-group">
            <label for="header-input">Header</label>
            <textarea class="form-control" id="header-input" rows="4" name="@Html.NameFor(p => p.Header)">@Model.Header</textarea>
        </div>
        <div class="form-group">
            <label for="intro-input">Intro Line</label>
            <textarea class="form-control" id="intro-input" rows="4" name="@Html.NameFor(p => p.IntroLine)">@Model.IntroLine</textarea>
        </div>
        <div class="form-group">
            <label for="body-input">Body</label>
            <textarea class="form-control" id="body-input" rows="4" name="@Html.NameFor(p => p.Body)">@Model.Body</textarea>
        </div>
        <div class="form-group">
            <label for="footer-input">Footer</label>
            <textarea class="form-control" id="footer-input" rows="4" name="@Html.NameFor(p => p.FooterText)">@Model.FooterText</textarea>
        </div>
        <div class="text-center mb-5">
            <a href="/Settings/EmailTemplate" class="btn btn-secondary">Cancel</a>
            <button type="submit" class="btn btn-dark">Save Changes</button>
        </div>
    </form>
</div>
