@model HypnoTech.Cms.Models.CmsListViewModel
@{
    Layout = "_CmsLayout";
    ViewData["Title"] = Model.DisplayName;
}
<div class="container" id="cms-list">
    <h1>@Model.PluralDisplayName</h1>

    <div class="input-group my-5">
        <input type="text" class="form-control" placeholder="Search" aria-label="Search" aria-describedby="input-search" value="@Model.Search" id="search-text" data-bind="textInput: searchText">
        <div class="input-group-append">
            <button class="input-group btn btn-dark" type="button" id="input-search">
                <i class="fa fa-search"></i>
                <span class="sr-only">Search</span>
            </button>
        </div>
    </div>
  
    <table class="table table-striped">
        <thead>
            <tr>
                @foreach (var heading in Model.Listing.Headings)
                {
                    <th>
                        @heading.Name
                        @if (!Model.Ordered)
                        {
                            <i class="pointer @heading.SortClass" data-sort data-column-index="@Model.Listing.Headings.IndexOf(heading)" data-column-sort="@heading.Sort"></i>
                        }
                    </th>
                }
                @if (Model.CanEdit || Model.CanRemove || Model.CanDuplicate)
                {
                    <th class="text-right">
                        @if (Model.CanAdd)
                        {
                            <a href="@Model.AddUrl" class="btn btn-sm btn-dark">Add @Model.SingularDisplayName</a>
                        }
                        else
                        {
                            <span>Actions</span>
                        }
                    </th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Model.Listing.Rows.Any())
            {
                @foreach (var row in Model.Listing.Rows)
                {
                    <tr>
                        @foreach (var cell in row.Cells)
                        {
                            <td>@cell</td>
                        }
                        @if (Model.CanEdit || Model.CanRemove || Model.Ordered)
                        {
                            <td class="text-right">
                                @if (Model.Ordered)
                                {
                                    @if (Model.Listing.CanMoveUp(row))
                                    {
                                        <a href="@string.Format(Model.MoveUpUrl, row.Id)" class="btn btn-sm btn-dark"><i class="fa fa-arrow-up"></i><span class="sr-only">Move Before</span></a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-dark" disabled="disabled"><i class="fa fa-arrow-up"></i><span class="sr-only">Move Before</span></button>
                                    }
                                    @if (Model.Listing.CanMoveDown(row))
                                    {
                                        <a href="@string.Format(Model.MoveDownUrl, row.Id)" class="btn btn-sm btn-dark"><i class="fa fa-arrow-down"></i><span class="sr-only">Move After</span></a>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-dark" disabled="disabled"><i class="fa fa-arrow-down"></i><span class="sr-only">Move After</span></button>
                                    }
                                }
                                @if (Model.CanEdit)
                                {
                                    <a href="@string.Format(Model.EditUrl, row.Id)" class="btn btn-sm btn-dark" data-id="@row.Id"><i class="fa fa-pen"></i><span class="sr-only">Edit</span></a>
                                }
                                @if (Model.CanDuplicate)
                                {
                                    <a href="@string.Format(Model.DuplicateUrl, row.Id)" class="btn btn-sm btn-dark" data-id="@row.Id"><i class="fa fa-copy"></i><span class="sr-only">Duplicate</span></a>
                                }
                                @if (Model.CanRemove)
                                {
                                    <button class="btn btn-sm btn-dark" data-id="@row.Id" data-toggle="modal" data-target="#deleteModal" data-title="@row.Title"><i class="fa fa-times"></i><span class="sr-only">Remove</span></button>
                                }
                            </td>
                        }
                    </tr>
                }
            }
            else { 
            <tr>
                <td colspan="@(Model.Listing.Headings.Count + 1)">No items were added yet</td>
            </tr>
            }
        </tbody>
    </table>
</div>
@Html.DisplayFor(p => p.Pager)



<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Modal title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong id="item-title"></strong> from @Model.DisplayName?</p>

            </div>
            <div class="modal-footer">
                <form action="@Model.RemoveUrl" method="POST" id="remove-form">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="remove-id" name="id" />
                    <button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-dark">Delete item</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts{
    <script type="text/javascript">
        var model = new CmsListViewModel();
        ko.applyBindings(model, document.getElementById("cms-list"));
    </script>
}
