<div class="modal fade" id="tinymce-youtube" role="dialog">
    <div class="modal-dialog">
        <div class="modal-content">
            <form role="form" id="tinymce-youtube-form" name="tinymceImageUploadForm" autocomplete="off" novalidate="novalidate">
                <div class="modal-header">
                    <h5 class="modal-title">Embed YouTube Video</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <label for="tinymce-youtube-url">YouTube Url</label>
                    <input class="form-control" type="text" id="tinymce-youtube-url" />
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" type="button" data-dismiss="modal">Close</button>
                    <button class="btn btn-dark">Embed</button>
                </div>
            </form>
        </div>
    </div>
</div>