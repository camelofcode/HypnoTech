@model object

@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Forgot Password";
}
<div class="container">
    <div class="row  justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-5">
                <a href="/Home/Login" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
                Forgot Password
            </h1>
            <div class="card">
                <div class="card-body">
                    <form method="POST">
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="email-input">Enter Email or Username</label>
                            <div class="input-group m-w-250">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                                </div>
                                <input class="form-control" id="email-input" type="text"  name="NameOrEmail">
                                <div class="invalid-feedback">
                                    Invalid email
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-dark">Reset my Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>