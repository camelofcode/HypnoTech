@model HypnoTech.Cms.Mvc.ViewModels.ForgottenPasswordViewModel

@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Change Password";
}
<div class="container">
    <div class="row  justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-5">Reset Password</h1>
            <div class="card">
                <div class="card-body">
                    <form method="POST" asp-action="ResetPassword">
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(model => model.Code)
                        <div class="form-group">
                            <label for="new-password-input">Enter New Password</label>
                            <div class="input-group m-w-250">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                                </div>
                                <input class="form-control" id="new-password-input" type="password" name="@Html.NameFor(p => p.Password)">
                            </div>
                        </div>
                        <div class="form-group">
                            <label for="repeat-new-password-input">Repeat New Password</label>
                            <div class="input-group m-w-250">
                                <div class="input-group-prepend">
                                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                                </div>
                                <input class="form-control" id="repeat-new-password-input" type="password" name="@Html.NameFor(p => p.ConfirmPassword)">
                            </div>
                        </div>
                        <button type="submit" class="btn btn-dark">Change my Password</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>