@model object

@{
    Layout = "_LoginLayout";
    ViewBag.Title = "Forgot Password";
}
<div class="container">
    <div class="row  justify-content-center">
        <div class="col-md-6">
            <h1 class="mb-5">
                <a href="/Home/Login" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
                Forgot Password
            </h1>
            <div class="card">
                <div class="card-body text-center">
                    <p>Your forgotten password link has expired. Please try again, and ensure you complete the process within 30 minutes.</p>
                    <a href="/Home/ForgotPassword" type="button" class="btn btn-dark">Reset my Password</a>
                </div>
            </div>
        </div>
    </div>
</div>