@model HypnoTech.Cms.Areas.Settings.ViewModels.AddUserViewModel

@{
    ViewBag.Title = "Add User";
    Layout = "_SettingsLayout";
}
<div class="container">
    <h1 class="mb-5">
        <a href="/Settings/User" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
        Add User
    </h1>
    
    <form class="m-w-250" method="POST">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label for="username-input">Username</label>
            <div class="input-group m-w-250">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-user"></i></span>
                </div>
                <input class="form-control" type="text" value="" id="username-input" name="@Html.NameFor(model => model.Username)">
            </div>
            <div class="invalid-feedback m-w-250">
                Username must be unique and not contain special characters
            </div>
        </div>
        <div class="form-group">
            <label for="email-input">Email Address</label>
            <div class="input-group m-w-250">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-envelope"></i></span>
                </div>
                <input class="form-control" id="email-input" type="email" value="" name="@Html.NameFor(model => model.Email)">
                <div class="invalid-feedback">
                    Invalid email
                </div>
            </div>

        </div>
        <div class="form-group">
            <label for="new-password-input">Enter New Password</label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                </div>
                <input class="form-control" id="new-password-input" type="password" name="@Html.NameFor(model => model.Password)">
            </div>
        </div>
        <div class="form-group">
            <label for="repeat-new-password-input">Repeat New Password</label>
            <div class="input-group">
                <div class="input-group-prepend">
                    <span class="input-group-text"><i class="fa fa-key"></i></span>
                </div>
                <input class="form-control" id="repeat-new-password-input" type="password" name="@Html.NameFor(model => model.ConfirmPassword)">
                <div class="invalid-feedback">
                    Passwords don't match
                </div>
            </div>
        </div>
        
        <div class="form-group">
            <label>Roles</label>
            @foreach (var role in Model.AvailableRoles)
            {
                <div class="d-flex justify-content-between mb-2">
                    <span class="badge badge-dark"><span class="lead">@role</span></span>
                    <label class="switch">
                        <input type="checkbox" value="@role" name="@Html.NameFor(model => model.Roles)">
                        <span class="slider"></span>
                    </label>
                </div>
            }
        </div>

        <div class="d-flex mt-5 justify-content-between">
            <a class="btn btn-secondary" href="/Settings/User">Cancel</a>
            <button class="btn btn-dark" type="submit">Create User</button>
        </div>
    </form>
</div>
