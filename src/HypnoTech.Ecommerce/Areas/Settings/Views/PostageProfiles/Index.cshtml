@using System.Globalization
@model HypnoTech.Ecommerce.Areas.Settings.Models.PostageProfilesViewModel
@{
    ViewBag.Title = "Postage Profiles";
    Layout = "_SettingsLayout";
}
<div class="container-fluid">
    <h1 class="mb-5">Postage Profiles</h1>

    <table class="table table-striped">
        <tr>
            <th>Name</th>
            <th class="text-right">UK First</th>
            <th class="text-right">UK Subsequent</th>
            <th class="text-right">EU First</th>
            <th class="text-right">EU Subsequent</th>
            <th class="text-right">RoW 1 First</th>
            <th class="text-right">RoW 1 Subsequent</th>
            <th class="text-right">RoW 2 First</th>
            <th class="text-right">RoW 2 Subsequent</th>
            <th class="text-right">RoW 3 First</th>
            <th class="text-right">RoW 3 Subsequent</th>
            <th class="text-right">
                <a href="/Settings/PostageProfiles/Add" class="btn btn-sm btn-dark">Add Postage Profile</a>
            </th>
        </tr>
        @{
            var culture = new CultureInfo("en-GB");
        }
        @foreach (var profile in Model.Profiles)
        {
            <tr>
                <td><strong>@profile.Name</strong></td>
                <td class="text-right">@profile.UnitedKingdom.Alone.ToString("C", culture)</td>
                <td class="text-right">@profile.UnitedKingdom.WithOthers.ToString("C", culture)</td>
                <td class="text-right">@profile.EuropeanUnion.Alone.ToString("C", culture)</td>
                <td class="text-right">@profile.EuropeanUnion.WithOthers.ToString("C", culture)</td>
                <td class="text-right">@profile.RestOfWorld1.Alone.ToString("C", culture)</td>
                <td class="text-right">@profile.RestOfWorld1.WithOthers.ToString("C", culture)</td>
                <td class="text-right">@profile.RestOfWorld2.Alone.ToString("C", culture)</td>
                <td class="text-right">@profile.RestOfWorld2.WithOthers.ToString("C", culture)</td>
                <td class="text-right">@profile.RestOfWorld3.Alone.ToString("C", culture)</td>
                <td class="text-right">@profile.RestOfWorld3.WithOthers.ToString("C", culture)</td>
                <td class="text-right">
                    <a href="/Settings/PostageProfiles/Edit/@profile.Id" class="btn btn-sm btn-dark"><i class="fa fa-pen"></i><span class="sr-only">Edit</span></a>
                    @if (profile.CanDelete)
                    {
                        <button class="btn btn-sm btn-dark" data-id="@profile.Id" data-title="@profile.Name" data-toggle="modal" data-target="#deleteModal"><i class="fa fa-times"></i><span class="sr-only">Remove</span></button>
                    }
                    else
                    {
                        <button class="btn btn-sm btn-dark" data-id="@profile.Id" data-title="@profile.Name" data-no-delete><i class="fa fa-times"></i><span class="sr-only">Remove</span></button>
                    }
                </td>
            </tr>
        }

    </table>

    <div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteModalLabel">Modal title</h5>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <p>Are you sure you want to delete <strong id="item-title"></strong> from Users?</p>

                </div>
                <div class="modal-footer">
                    <form action="" method="POST" id="remove-form" data-action="/Settings/PostageProfiles/Remove/">
                        @Html.AntiForgeryToken()
                        <button type="button" class="btn btn-light" data-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-dark">Delete item</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


@section Scripts{
    <script type="text/javascript">
        document.addEventListener('click',
            function (event) {
                //Delete modal hookup
                if (event.target.matches('[data-target="#deleteModal"]') ||
                    event.target.parentElement.matches('[data-target="#deleteModal"]')) {
                    var id = event.target.getAttribute("data-id") || event.target.parentElement.getAttribute("data-id");
                    var title = event.target.getAttribute("data-title") || event.target.parentElement.getAttribute("data-title");

                    document.getElementById("item-title").innerText = title;

                    var removeForm = document.getElementById("remove-form");
                    removeForm.action = removeForm.getAttribute("data-action") + id;

                } else if (event.target.matches('[data-no-delete]') ||
                    event.target.parentElement.matches('[data-no-delete]')){
                    var noDeleteTitle = event.target.getAttribute("data-title") || event.target.parentElement.getAttribute("data-title");
                    messages.danger("'" +
                        noDeleteTitle +
                        "' cannot be removed as it has merch associated. Move all merch to a different profile before removing.");

                }
            },
            false);
    </script>
}

