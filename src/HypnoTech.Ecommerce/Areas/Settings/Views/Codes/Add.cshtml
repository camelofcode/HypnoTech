@model HypnoTech.Ecommerce.Areas.Settings.Models.AddCodeCollectionViewModel

@{
    ViewBag.Title = "Add Codes";
    Layout = "_SettingsLayout";
}
<div class="container">
    <h1>
        <a href="/Settings/Codes" class="btn btn-dark rounded-circle mt-n2"><i class="fa fa-arrow-left"></i><span class="sr-only">Back</span></a>
        Add Download Codes
    </h1>
    
    <form method="POST">
        @Html.AntiForgeryToken()
        <div class="form-group">
            <label for="name-input">Name</label>
            <input class="form-control" type="text" id="name-input" name="@Html.NameFor(p => p.Name)">
        </div>
        <div class="form-group">
            <label for="url-input">Redemption Url</label>
            <input class="form-control" type="text" id="url-input" name="@Html.NameFor(p => p.RedemptionUrl)">
        </div>

        <div class="form-group">
            <label for="codes-input">Codes (One per line)</label>
            <textarea class="form-control" type="text" id="codes-input" name="@Html.NameFor(p => p.Codes)"></textarea>
        </div>

        <div class="text-center mb-5">
            <a href="/Settings/Codes" class="btn btn-secondary">Cancel</a>
            <button class="btn btn-dark">Save Changes</button>
        </div>
    </form>
</div>
