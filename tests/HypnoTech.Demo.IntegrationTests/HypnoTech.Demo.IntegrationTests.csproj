  </ItemGroup>

  <ItemGroup>
    <Content Include="../../examples/HypnoTech.Demo.Admin/SeedData/**/*.json"
             Link="SeedData/%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
