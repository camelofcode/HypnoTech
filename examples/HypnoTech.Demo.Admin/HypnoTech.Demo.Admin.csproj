<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <BuildInParallel>false</BuildInParallel>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <ProjectReference Include="../HypnoTech.Demo.Models/HypnoTech.Demo.Models.csproj" />
    <ProjectReference Include="../../src/Cms/HypnoTech.Cms/HypnoTech.Cms.csproj" />
    <ProjectReference Include="../../src/Ecommerce/HypnoTech.Ecommerce/HypnoTech.Ecommerce.csproj" />
    <ProjectReference Include="../../src/Media/HypnoTech.Media/HypnoTech.Media.csproj" />

    <!-- The showcase references every adapter. Real applications reference only their chosen provider. -->
    <ProjectReference Include="../../src/Cms/HypnoTech.Cms.MongoDb/HypnoTech.Cms.MongoDb.csproj" />
    <ProjectReference Include="../../src/Common/HypnoTech.Common.Dal.MongoDb/HypnoTech.Common.Dal.MongoDb.csproj" />
    <ProjectReference Include="../../src/Ecommerce/HypnoTech.Ecommerce.Dal.MongoDb/HypnoTech.Ecommerce.Dal.MongoDb.csproj" />
    <ProjectReference Include="../../src/Media/HypnoTech.Media.Dal.MongoDb/HypnoTech.Media.Dal.MongoDb.csproj" />
    <ProjectReference Include="../../src/Cms/HypnoTech.Cms.EntityFrameworkCore/HypnoTech.Cms.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/Common/HypnoTech.Common.Dal.EntityFrameworkCore/HypnoTech.Common.Dal.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/Ecommerce/HypnoTech.Ecommerce.Dal.EntityFrameworkCore/HypnoTech.Ecommerce.Dal.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/Media/HypnoTech.Media.Dal.EntityFrameworkCore/HypnoTech.Media.Dal.EntityFrameworkCore.csproj" />
    <ProjectReference Include="../../src/Persistence/HypnoTech.EntityFrameworkCore.PostgreSql/HypnoTech.EntityFrameworkCore.PostgreSql.csproj" />
    <ProjectReference Include="../../src/Persistence/HypnoTech.EntityFrameworkCore.SqlServer/HypnoTech.EntityFrameworkCore.SqlServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../HypnoTech.Demo.Website/wwwroot/images/artwork-*.svg"
             Link="DemoUploads/images/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HypnoTech.Demo.Website/wwwroot/documents/*.txt"
             Link="DemoUploads/documents/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../HypnoTech.Demo.Website/wwwroot/media/lantern-*"
             Link="DemoUploads/media/%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
