{
  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "AllowedHosts": "localhost",
  "HostURL": "http://localhost:5100",
  "CanonicalUrl": "http://localhost:5100",
  "UploadPath": ".demo/uploads",
  "ApiKey": "demo-only-api-key",
  "Mongo": {
    "UseMongo": true,
    "Server": "localhost",
    "Port": 27017,
    "Database": "hypnotech_demo"
  },
  "Media": {
    "AudioEnabled": true,
    "PhotoAlbumsEnabled": true,
    "YouTubeVideosEnabled": false
  },
  "Ecommerce": {
    "Enabled": true
  },
  "ContentSecurityPolicy": {
    "media-src": "blob:"
  }
}
