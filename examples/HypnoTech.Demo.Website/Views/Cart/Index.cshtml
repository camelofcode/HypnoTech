@{
    ViewData["Title"] = "Basket";
    ViewData["CartElementId"] = "cart";
}
<header class="page-header">
    <span class="eyebrow">Demo ecommerce</span>
    <h1>Your basket</h1>
    <p>The engine stores item identifiers in its cart cookie and recalculates names and prices from MongoDB.</p>
</header>
<section id="cart" class="section cart-layout" data-testid="cart-page">
    <div>
        <h2>Items</h2>
        <p data-bind="visible: items().length === 0">Your basket is empty.</p>
        <div data-bind="foreach: items" data-testid="cart-items">
            <div class="cart-row">
                <div><strong data-bind="text: displayName"></strong><span>Quantity <span data-bind="text: quantity"></span></span></div>
                <div><strong data-bind="text: formattedRowPrice"></strong><button class="text-button" type="button" data-bind="click: $parent.removeItem">Remove</button></div>
            </div>
        </div>
        <button class="text-button" type="button" data-bind="click: clearCart, visible: items().length > 0">Clear basket</button>
    </div>
    <aside class="order-summary">
        <h2>Summary</h2>
        <dl><div class="total"><dt>Items</dt><dd data-bind="text: formattedSubtotal">£0.00</dd></div></dl>
        <a class="button button-primary" asp-controller="Checkout" asp-action="Index" data-bind="css: { disabled: items().length === 0 }">Review demo checkout</a>
        <div class="checkout-safety is-visible" data-testid="demo-checkout-safety"><strong>No payment provider is connected.</strong><p>The checkout demonstrates calculation only.</p></div>
    </aside>
</section>
