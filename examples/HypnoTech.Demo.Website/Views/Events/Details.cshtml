@model Event
@{
    ViewData["Title"] = Model.Title;
}
<article class="event-detail" data-testid="event-detail">
    <header><span class="pill">@Model.Type</span><h1>@Model.Title</h1><p>@Model.StartsAt.ToString("dddd d MMMM yyyy · HH:mm") · @Model.Venue</p></header>
    <img class="feature-image" src="@Model.ImagePath" alt="" />
    <div class="event-columns">
        <div class="rich-copy">@Html.Raw(Model.Description)</div>
        <aside><h2>Schedule</h2>@foreach (var entry in Model.Schedule.OrderBy(item => item.Order)) { <div class="schedule-row"><time>@entry.Time</time><div><strong>@entry.Title</strong><span>@entry.Format</span></div></div> }<a href="@Model.ProgrammePath">Download the sample programme</a></aside>
    </div>
    <div class="notice">Demo ticket price: <strong>£@Model.TicketPrice</strong>. No ticketing transaction is available.</div>
</article>
