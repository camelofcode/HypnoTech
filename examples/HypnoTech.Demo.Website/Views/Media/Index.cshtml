@model MediaViewModel
@{
    ViewData["Title"] = "Watch and listen";
}
<header class="page-header">
    <span class="eyebrow">Media library</span>
    <h1>Watch &amp; listen</h1>
    <p>CMS-managed audio, YouTube video and photo galleries, plus a self-hosted motion sample.</p>
</header>

<section class="section media-section" data-testid="media-audio">
    <div>
        <span class="eyebrow">Platform audio player</span>
        <h2>Lantern signal</h2>
        <p>The engine supplies the playlist data and player view model; this host supplies its visual treatment.</p>
    </div>
    <div id="audio-player" class="audio-player">
        <audio id="audio-element" preload="metadata" data-bind="attr: { src: currentTrack().path }"></audio>
        <div class="audio-now-playing" data-bind="with: currentTrack">
            <img src="" alt="" data-bind="attr: { src: imagePath }" />
            <div>
                <span class="eyebrow">Now playing</span>
                <strong data-bind="text: title"></strong>
            </div>
        </div>
        <div class="audio-controls">
            <button class="player-button" type="button" data-bind="click: play, visible: !playing()" aria-label="Play current track">Play</button>
            <button class="player-button" type="button" data-bind="click: pause, visible: playing" aria-label="Pause current track">Pause</button>
            <button id="progress-track" class="progress-track" type="button" data-bind="click: setPosition" aria-label="Seek through current track">
                <span data-bind="style: { width: positionPercent }"></span>
            </button>
        </div>
        <div class="audio-playlist" data-bind="foreach: tracks">
            <button type="button" data-bind="click: $parent.selectTrack, css: { 'is-current': $parent.isCurrent($data) }">
                <span data-bind="text: title"></span>
            </button>
        </div>
    </div>
</section>

<section class="section" data-testid="youtube-videos">
    <div class="section-heading">
        <div>
            <span class="eyebrow">CMS-managed video</span>
            <h2>YouTube showcase</h2>
        </div>
        <p>The video record is managed through HypnoTech Media. The iframe is only created after the visitor opens the lightbox.</p>
    </div>
    <div class="video-grid">
        @foreach (var video in Model.Videos)
        {
            <button class="video-card" type="button" data-video-id="@video.YouTubeId" data-video-title="@video.Title">
                <img src="@video.ThumbnailUrl" alt="" />
                <span><strong>@video.Title</strong><small>Open video</small></span>
            </button>
        }
    </div>
</section>

<section class="section media-section media-video" data-testid="media-video">
    <div>
        <span class="eyebrow">Self-hosted video</span>
        <h2>Light study</h2>
        <p>A tiny locally generated MP4 demonstrates byte-range delivery without a CDN.</p>
    </div>
    <video controls muted loop preload="metadata" poster="/Images/Demo/artwork-indigo.svg">
        <source src="/Files/Demo/lantern-motion.mp4" type="video/mp4" />
    </video>
</section>

<section class="section" data-testid="photo-galleries">
    <div class="section-heading">
        <div><span class="eyebrow">Photo galleries</span><h2>@Model.PhotoAlbums.FirstOrDefault()?.Title</h2></div>
    </div>
    @foreach (var album in Model.PhotoAlbums)
    {
        <div class="gallery">
            @foreach (var photo in album.Photos)
            {
                <figure><img src="@photo.ImagePath" alt="" /><figcaption>@photo.Caption</figcaption></figure>
            }
        </div>
    }
</section>

<dialog class="video-lightbox" data-video-lightbox aria-labelledby="video-lightbox-title">
    <div class="video-lightbox-header">
        <h2 id="video-lightbox-title" data-video-lightbox-title>Video</h2>
        <button type="button" data-video-lightbox-close aria-label="Close video">Close</button>
    </div>
    <div class="video-frame"><iframe title="" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
</dialog>

@section Scripts {
    <hypnotech-player-config player-element-id="audio-player" />
}
